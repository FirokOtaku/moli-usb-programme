<?xml version="1.0" encoding="UTF-8"?>
<!--
  MSU2 协议库（Java 实现）。

  四层单向依赖：领域 API -> 会话层 -> 编解码层 -> 传输层。
  传输层通过 Transport 接口注入，本模块不绑定具体 USB/串口调用方式。

  规范来源：spec/architecture.md 与 spec/msu2-wire-protocol.md。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>space.firok</groupId>
        <artifactId>moli-java-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <groupId>space.firok.moli.usb</groupId>
    <artifactId>moli-usb-api</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>Moli USB API</name>
    <description>MSU2 USB 屏幕协议库：领域 API、会话层、编解码层与可注入传输层</description>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
